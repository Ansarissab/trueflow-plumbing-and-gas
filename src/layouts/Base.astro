---
/**
 * Base document shell for the redesigned homepage.
 * Head facts (title, description, schema, OG) are provided by the page via props/slots.
 * Body copy, header, footer, etc. are composed on the page itself.
 */
import '../styles/home.css';

export interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD blocks (e.g. FAQPage) rendered verbatim. */
  schema?: string;
}
const { title, description, schema } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://moralservice.com.au/" />

    <link rel="icon" href="favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="favicon-v2-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-v2-32x32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="favicon-v2-256.png" />
    <link rel="icon" type="image/svg+xml" href="favicon-v2.svg" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <meta name="theme-color" content="#1327A7" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Moral Service" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://moralservice.com.au/" />
    <meta property="og:image" content="https://moralservice.com.au/images/og-home.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/_astro/archivo-latin-wght-normal.E0tuGl4L.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/_astro/inter-latin-wght-normal.Dx4kXJAl.woff2" as="font" type="font/woff2" crossorigin />

    <!-- LocalBusiness schema, identical facts to the existing site -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': ['Plumber', 'Electrician'],
      '@id': 'https://moralservice.com.au/#business',
      name: 'Moral Service',
      url: 'https://moralservice.com.au',
      logo: 'https://moralservice.com.au/moral-logo-primary.svg',
      image: 'https://moralservice.com.au/images/og-home.jpg',
      telephone: '+61 1300 522 107',
      email: 'contact@moralservice.com.au',
      openingHours: 'Mo-Fr 07:00-17:00',
      slogan: 'Setting the standard',
      foundingDate: '2019',
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '4.9',
        reviewCount: '149',
      },
      address: { '@type': 'PostalAddress', addressLocality: 'Gold Coast', addressRegion: 'QLD', addressCountry: 'AU' },
      areaServed: [{ '@type': 'City', name: 'Gold Coast' }],
      sameAs: [
        'https://www.instagram.com/moral_lads/',
        'https://www.instagram.com/moralelectrical/',
      ],
    })} />
    {schema && <script type="application/ld+json" set:html={schema} />}

    <!-- GA4, production domain only (same gating as the existing site) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-L5L6CQY9P4"></script>
    <script is:inline define:vars={{ ga4Id: 'G-L5L6CQY9P4' }}>
      (function () {
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        window.gtag = gtag;
        var on = /(^|\.)moralservice\.com\.au$/.test(location.hostname);
        try {
          if (/[?&]gtm=on(&|$)/.test(location.search)) sessionStorage.setItem('moral-service-gtm', 'on');
          if (sessionStorage.getItem('moral-service-gtm') === 'on') on = true;
        } catch (e) {}
        if (on) {
          gtag('js', new Date());
          gtag('config', ga4Id);
          document.addEventListener('click', function (e) {
            var a = e.target.closest && e.target.closest('a[href^="tel:"]');
            if (a) gtag('event', 'tel_click', { event_category: 'engagement', transport_type: 'beacon' });
          });
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />

    <!-- Reveal-on-scroll + sticky-bar arming (reduced-motion aware).
         Hidden states are gated behind a JS-added `js-reveal` class on <html> —
         content stays fully visible with JS off. The script also strips each
         element's stagger delay once its reveal completes. -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        if (html.classList.contains('js-reveal')) return;
        html.classList.add('js-reveal');

        var bar = document.querySelector('.mbar');
        if (bar) bar.classList.add('mbar--armed');

        var els = Array.prototype.slice.call(document.querySelectorAll('[data-reveal],[data-reveal-letter]'));
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('in'); });
          return;
        }

        // Sibling stagger: 80ms steps inside each [data-reveal-group] (letters
        // and other non-grouped elements carry their own inline delays).
        document.querySelectorAll('[data-reveal-group]').forEach(function (group) {
          var kids = Array.prototype.slice.call(group.querySelectorAll('[data-reveal]'));
          kids.forEach(function (el, i) { el.style.setProperty('--rd', (i * 80) + 'ms'); });
        });

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            var el = e.target;
            io.unobserve(el);
            el.classList.add('in');
            el.addEventListener('transitionend', function done(ev) {
              if (ev.target !== el || (ev.propertyName !== 'transform' && ev.propertyName !== 'opacity')) return;
              el.style.removeProperty('--rd');
              el.removeEventListener('transitionend', done);
            });
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
