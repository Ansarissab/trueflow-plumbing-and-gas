---
import Icon from './Icon.astro';

const points = [
  {
    icon: 'badge' as const,
    title: 'Licensed & guaranteed',
    text: 'QBCC-licensed, fully insured, and every job is backed by the TrueFlow guarantee.',
  },
  {
    icon: 'wallet' as const,
    title: 'Fixed prices, approved first',
    text: 'You see the number and say the word before we start. What we quote is what lands on the invoice.',
  },
  {
    icon: 'clock' as const,
    title: 'We turn up when we say',
    text: 'A live arrival window, and a phone call the minute anything changes.',
  },
  {
    icon: 'sparkles' as const,
    title: 'Your home left better',
    text: 'Boot covers, drop sheets and a full wipe-down before we go, so you can barely tell we were there.',
  },
];

const stats = [
  { value: '15+', label: 'Years on the tools' },
  { value: '300+', label: 'Jobs a year' },
  { value: '4.9★', label: 'Client rating' },
  { value: '100%', label: 'Fixed-price quotes' },
];
---

<section id="why-us" class="guide section" aria-labelledby="guide-heading">
  <div class="guide-bg" aria-hidden="true">
    <img
      src="/images/guide-bg.jpg"
      alt=""
      width="1920"
      height="1080"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="guide-scrim" aria-hidden="true"></div>

  <div class="container guide-inner">
    <div class="guide-copy">
      <p class="eyebrow">Why TrueFlow</p>
      <h2 id="guide-heading">Run by a plumber, not a call centre.</h2>
      <p>
        TrueFlow started on the south side with a tradie who was tired of being
        booked out to clean up other companies’ quick fixes. Fifteen years on,
        we’re still a small local crew, with better tools and a guarantee we
        take personally.
      </p>
      <ul class="guide-points">
        {points.map(({ icon, title, text }) => (
          <li>
            <span class="point-icon"><Icon name={icon} /></span>
            <div>
              <b>{title}</b>
              <span>{text}</span>
            </div>
          </li>
        ))}
      </ul>
      <div class="guide-stats">
        {stats.map(({ value, label }) => (
          <div>
            <b>{value}</b>
            <small>{label}</small>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
