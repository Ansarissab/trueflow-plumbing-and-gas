---
/** Sticky site header — homepage version only (other pages keep their own markup). */
const nav = [
  { href: 'index.html', label: 'Home', current: true },
  { href: 'plumber-gold-coast/index.html', label: 'Plumbing' },
  { href: 'electrician-gold-coast/index.html', label: 'Electrical' },
  { href: 'about/index.html', label: 'About' },
  { href: 'locations/index.html', label: 'Locations' },
  { href: 'contact/index.html', label: 'Contact' },
];
---

<header class="hdr">
  <div class="container hdr__inner">
    <a class="hdr__logo" href="index.html" aria-label="Moral Service home">
      <img src="moral-logo-primary.svg" alt="Moral Service" width="200" height="44" />
    </a>

    <nav class="hdr__nav" aria-label="Primary">
      {nav.map((item) => (
        item.current
          ? <a href={item.href} aria-current="page">{item.label}</a>
          : <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="hdr__right">
      <a class="hdr__phone" href="tel:1300522107">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.4.55 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11 11 0 0 0 .55 3.4 1 1 0 0 1-.25 1l-2.2 2.4Z" />
        </svg>
        1300&nbsp;522&nbsp;107
      </a>
      <a class="btn btn--primary hdr__cta" href="#quote">Request a Quote</a>
    </div>

    <!-- Mobile: one-tap call + burger -->
    <a class="hdr__phone-m" href="tel:1300522107" aria-label="Call Moral Service on 1300 522 107">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.4.55 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11 11 0 0 0 .55 3.4 1 1 0 0 1-.25 1l-2.2 2.4Z"/>
      </svg>
      <span class="hdr__phone-m-t">Call</span>
    </a>

    <button class="hdr__burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="hmenu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="hmenu" id="hmenu" hidden>
    <nav aria-label="Mobile">
      <ul>
        {nav.filter((item) => !item.current).map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="hmenu__meta">
      <p><strong>Mon–Fri, 7am–5pm</strong> · 24/7 emergencies</p>
      <p>Plumbing &amp; electrical, Gold Coast wide.</p>
    </div>
    <a class="btn btn--primary" href="#quote">Get in touch</a>
  </div>
</header>

<script>
  const burger = document.querySelector('.hdr__burger');
  const menu = document.getElementById('hmenu');
  if (burger && menu && menu.getAttribute('data-bound') !== '1') {
    menu.setAttribute('data-bound', '1');
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      burger.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      menu.hidden = open;
      document.body.classList.toggle('menu-open', !open);
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        burger.setAttribute('aria-expanded', 'false');
        burger.setAttribute('aria-label', 'Open menu');
        menu.hidden = true;
        document.body.classList.remove('menu-open');
      })
    );
  }
</script>
