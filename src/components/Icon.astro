---
// Inline SVG icon renderer. Paths come from lucide-static via scripts/build-icons.mjs.
import { ICONS, ICON_VIEWBOX, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = '', strokeWidth = 2 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={ICON_VIEWBOX}
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={ICONS[name]}
/>
