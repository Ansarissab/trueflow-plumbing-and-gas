---
/** Compact credibility strip directly under the hero — verified facts only. */
const items = [
  {
    t: 'Owner-operated',
    d: 'You deal directly with Shaun and Justin — by phone, on site, at handover.',
  },
  {
    t: 'Both trades licensed',
    d: 'QLD and NSW plumbing and electrical licences, fully insured.',
  },
  {
    t: 'Price fixed first',
    d: 'You approve the price before work starts. No surprises on the invoice.',
  },
  {
    t: 'Work backed',
    d: 'Lifetime workmanship warranty on homes — see the full terms.',
  },
];
---

<section class="trust" aria-label="Why Gold Coast locals call Moral Service">
  <div class="container">
    <div class="trust__grid">
      {items.map((item) => (
        <div class="trust__item">
          <p class="trust__t">{item.t}</p>
          <p class="trust__d">{item.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>
