---
import Icon from './Icon.astro';

const phone = '1300 478 879';
const tel = 'tel:+611300478879';

const serviceLinks = [
  { href: '#services', label: 'Blocked drains' },
  { href: '#services', label: 'Hot water systems' },
  { href: '#services', label: 'Gas fitting' },
  { href: '#services', label: 'Repairs & maintenance' },
  { href: '#services', label: 'Strata & commercial' },
];

const companyLinks = [
  { href: '#why-us', label: 'Why TrueFlow' },
  { href: '#how-it-works', label: 'How it works' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#faq', label: 'FAQ' },
  { href: '#contact', label: 'Get a quote' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div>
        <a class="brand" href="/" aria-label="TrueFlow Plumbing &amp; Gas, back to home">
          <span class="brand__mark">
            <Icon name="droplet" aria-hidden="true" />
          </span>
          <span>
            <span class="brand__name">True<span>Flow</span></span>
            <span class="brand__tag">Plumbing &amp; Gas</span>
          </span>
        </a>
        <p>
          A small, licensed crew keeping water moving across Brisbane Southside
          and Logan. Fixed prices, on-time arrivals and work that’s guaranteed.
        </p>
      </div>

      <nav aria-label="Services">
        <h4>Services</h4>
        <ul class="footer-links">
          {serviceLinks.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Company">
        <h4>Company</h4>
        <ul class="footer-links">
          {companyLinks.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>

      <div>
        <h4>Good to know</h4>
        <ul class="footer-contact">
          <li>
            <Icon name="phone" aria-hidden="true" />
            <span><a href={tel}>{phone}</a></span>
          </li>
          <li>
            <Icon name="clock" aria-hidden="true" />
            <span>Mon–Sat · 6:30am–7pm</span>
          </li>
          <li>
            <Icon name="pin" aria-hidden="true" />
            <span>Brisbane Southside &amp; Logan</span>
          </li>
          <li>
            <Icon name="shield" aria-hidden="true" />
            <span>QBCC 1234567 · ABN 12 345 678 901</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>
        © 2026 TrueFlow Plumbing &amp; Gas, a fictional brand built for a
        portfolio demo. All credentials are placeholders.
      </p>
      <p>
        Photos by <a href="https://www.pexels.com/@ar-abnoy-536397811/" rel="noopener">AR Abnoy</a>
        &amp; <a href="https://www.pexels.com/@sejio402" rel="noopener">sejio402</a>
        via <a href="https://www.pexels.com/license/" rel="noopener">Pexels</a>
      </p>
    </div>
  </div>
</footer>
