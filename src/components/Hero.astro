---
/** Hero — two-column; copy left, real photo of the brothers right. */
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="label">Family owned &amp; operated · Gold Coast QLD</span>

      <h1 class="display hero__h1">
        Plumbing &amp; electrical on the Gold&nbsp;Coast.
        <span class="h1b">Done by the brothers who quote your job.</span>
      </h1>

      <p class="lead hero__sub">
        Shaun handles the plumbing. Justin handles the electrical
        and both of them answer the phone. Straightforward pricing, quality work, no surprises.
      </p>

      <ul class="hero__urgent">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 18v-6a5 5 0 1 1 10 0v6"/>
            <path d="M5 21a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-1a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2z"/>
            <path d="M21 12h1M18.5 4.5 18 5M2 12h1M12 2v1M4.93 4.93l.71.71M12 12v6"/>
          </svg>
          24/7 emergencies
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 2v4M16 2v4"/>
            <rect width="18" height="18" x="3" y="4" rx="2"/>
            <path d="M3 10h18"/>
            <path d="m9 16 2 2 4-4"/>
          </svg>
          Same-day service
        </li>
      </ul>

      <div class="hero__cta">
        <a class="btn btn--primary" href="tel:1300522107">Call&nbsp;1300&nbsp;522&nbsp;107</a>
        <a class="btn" href="#quote">Request a quote</a>
        <a class="grate" href="#reviews" aria-label="Rated 4.9 out of 5 on Google — jump to reviews">
          <img class="grate__g" src="images/google-g.svg" alt="" width="24" height="24" />
          <span class="grate__body">
            <span class="grate__top">
              <strong class="grate__score">4.9</strong>
              <span class="grate__stars" aria-hidden="true">{Array.from({ length: 5 }).map(() => (
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3-5.8 3 1.1-6.5L2.6 9.4l6.5-.9z"/></svg>
              ))}</span>
            </span>
            <span class="grate__label">149 Google reviews</span>
          </span>
        </a>
      </div>

      <div class="hero__creds" aria-label="Industry memberships">
        <span class="hero__cred">
          <img src="images/badges/mpaq.png" alt="Master Plumbers' Association of Queensland member" width="289" height="68" loading="lazy" />
        </span>
        <span class="hero__cred">
          <img src="images/badges/master-electricians.png" alt="Master Electricians member" width="288" height="78" loading="lazy" />
        </span>
      </div>
    </div>

    <div class="hero__media">
      <figure class="plate plate--hard hero__photo">
        <picture>
          <source media="(max-width: 767px)" srcset="images/hero-mobile.jpg" width="900" height="865" />
          <img
            src="images/hero.jpg"
            width="1600" height="970"
            fetchpriority="high"
            alt="Shaun and Justin, the two brothers who own Moral Service, walking out the front gate of a Gold Coast home with their tools" />
        </picture>
        <figcaption class="plate__cap">
          <span>Shaun &amp; Justin</span>
          <small>The owners are the tradies</small>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
