---
import Icon from './Icon.astro';

const phone = '1300 478 879';
const tel = 'tel:+611300478879';

const services = [
  {
    icon: 'droplets' as const,
    meta: 'CCTV & jet blasting',
    title: 'Blocked drains',
    text: 'Camera inspections and jet blasting that clear sinks, showers, sewers and stormwater properly, instead of pushing the blockage deeper.',
  },
  {
    icon: 'hot' as const,
    meta: 'Repairs & installs',
    title: 'Hot water systems',
    text: 'Gas, electric and heat-pump repairs and installs from brands you know. Warm shower tonight, honest advice on what should be replaced.',
  },
  {
    icon: 'shower' as const,
    meta: 'Renos & fixtures',
    title: 'Bathroom & kitchen',
    text: 'Taps, mixers, vanities and full reno plumbing, finished clean enough to appear in the listing photos.',
  },
  {
    icon: 'flame' as const,
    meta: 'Gas certificates',
    title: 'Gas fitting',
    text: 'Licensed gas work, covering cooktops, bayonets, heaters and leak checks, with a compliance certificate every single time.',
  },
  {
    icon: 'wrench' as const,
    meta: 'Fixed prices upfront',
    title: 'Repairs & maintenance',
    text: 'Leaking taps, running toilets, burst pipes. The price is agreed with you before a single tool comes out.',
  },
  {
    icon: 'building' as const,
    meta: 'Service reports',
    title: 'Strata & commercial',
    text: 'Fast, tidy call-outs for body corporates and Southside small businesses, written up in reports your committee can actually read.',
  },
];
---

<section id="services" class="section" aria-labelledby="services-heading">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow eyebrow--center">What we handle</p>
      <h2 id="services-heading">One crew for everything water does in your home.</h2>
      <p>
        From the midnight burst pipe to the renovation you’ve been planning
        since Christmas, it’s always the same crew and the same straight
        pricing.
      </p>
    </div>

    <div class="services-grid">
      {services.map(({ icon, meta, title, text }) => (
        <article class="card service-card">
          <span class="service-icon"><Icon name={icon} /></span>
          <p class="service-meta">{meta}</p>
          <h3>{title}</h3>
          <p>{text}</p>
          <a class="service-link" href="#contact">
            Request this job
            <Icon name="arrow" aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>

    <p class="services-foot">
      Not sure where your problem fits? Call
      <a href={tel}>{phone}</a>
      and describe it to a real person. We’ll tell you straight what it needs.
    </p>
  </div>
</section>
