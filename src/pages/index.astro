---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Problems from '../components/Problems.astro';
import Services from '../components/Services.astro';
import Guide from '../components/Guide.astro';
import Plan from '../components/Plan.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';

const title = 'TrueFlow Plumbing & Gas | Same-Day Plumbers, Brisbane Southside & Logan';
const description =
  'Same-day plumber for Brisbane Southside and Logan. Blocked drains, burst pipes, leaking taps, hot water systems and licensed gas fitting with fixed prices approved before we start and no call-out fee.';
---

<Base title={title} description={description} preloadHero>
  <Hero />
  <Problems />
  <Services />
  <Guide />
  <Plan />
  <Reviews />
  <Faq />
  <Contact />
</Base>
